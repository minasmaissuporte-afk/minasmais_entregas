    {
      "name": "3. Erros esperados",
      "description": "Chamadas que devem falhar, para conferir os códigos de erro da seção 5.",
      "item": [
        {
          "name": "401 - sem token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Erro CREDENCIAL_AUSENTE\", () => pm.expect(pm.response.json().erro.codigo).to.eql(\"CREDENCIAL_AUSENTE\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/entregas/{{idVenda}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "entregas",
                "{{idVenda}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "401 - token inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Erro CREDENCIAL_INVALIDA\", () => pm.expect(pm.response.json().erro.codigo).to.eql(\"CREDENCIAL_INVALIDA\"));"
                ]
              }
            }
