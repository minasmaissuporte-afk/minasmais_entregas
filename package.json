{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.cjs",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/minas-mais-entregas run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:start": "node scripts/local-db.cjs start",
    "db:stop": "node scripts/local-db.cjs stop",
    "db:status": "node scripts/local-db.cjs status",
    "build": "pnpm run typecheck && pnpm -r --filter \"!@workspace/minas-mais-motoboy\" --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
