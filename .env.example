# Copie este arquivo para .env (na raiz do projeto) e preencha os valores.
# O .env NÃO deve ser commitado.

# ---------- API ----------
# Porta da API (o painel encaminha /api para cá em desenvolvimento)
PORT=8080
LOG_LEVEL=info

# Postgres (local ou gerenciado)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minas_mais_entregas

# Supabase Auth (login). Painel do projeto → Project Settings → API Keys.
# A API valida o token pelas chaves públicas do projeto (JWKS); não precisa de segredo para isso.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta (sb_secret_…): usada só pela API para excluir o login quando um admin exclui uma conta.
# Nunca coloque esta chave em variáveis VITE_ (elas vão para o navegador).
SUPABASE_SECRET_KEY=
# Só para projetos antigos que ainda assinam tokens com segredo compartilhado (HS256).
# SUPABASE_JWT_SECRET=

# E-mails que viram ADMIN no primeiro acesso (separados por vírgula)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_EMAILS=

# Google Maps Platform (servidor) — chave restrita por API no Google Cloud.
# APIs a ativar: Places API (New), Geocoding API e Routes API.
GOOGLE_MAPS_API_KEY=
# Route Optimization API (rotas agrupadas): exige conta de serviço, não aceita chave.
# JSON da conta de serviço em uma linha, com o papel "Route Optimization Editor".
# Se ficar vazio, usa FIREBASE_SERVICE_ACCOUNT_JSON (mesmo projeto do Google Cloud).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opcional: projeto do Google Cloud (padrão: project_id da conta de serviço)
# GOOGLE_CLOUD_PROJECT=

# Web Push — REUTILIZE as mesmas chaves do Replit, senão as inscrições atuais param de funcionar
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@drogariasminasmais.com.br

# Firebase (push no app Android) — JSON da conta de serviço em uma linha
FIREBASE_SERVICE_ACCOUNT_JSON=

# Armazenamento das fotos de comprovante.
# ATENÇÃO: o código atual só funciona dentro do Replit; será trocado na Fase 2.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ---------- Painel web (Vite) ----------
WEB_PORT=5173
BASE_PATH=/
# Opcional: para onde o Vite encaminha /api (padrão http://localhost:$PORT)
# API_PROXY_TARGET=

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (sb_publishable_…). Pode ir para o navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Chave do navegador para a Maps JavaScript API (restrinja por domínio: localhost e o domínio do app)
VITE_GOOGLE_MAPS_API_KEY=
# Map ID criado no Google Cloud (Map Management). Sem ele usa DEMO_MAP_ID, só para desenvolvimento.
VITE_GOOGLE_MAPS_MAP_ID=
# URL da API usada pelo app Android (Capacitor)
VITE_NATIVE_API_BASE_URL=https://minas-mais-entregas.replit.app
