modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk21"]

[userenv]

[userenv.shared]
INITIAL_ADMIN_EMAIL = "david@drogariasminasmais.com.br"
INITIAL_ADMIN_EMAILS = "balancocompulsorio@drogariasminasmais.com.br"
VAPID_SUBJECT = "mailto:contato@drogariasminasmais.com.br"
